# Copy to .env.
#
# Bu iki değer, Flutter uygulamasının kullandığı supabase.env.json dosyasındaki
# SUPABASE_URL ve SUPABASE_PUBLISHABLE_KEY ile BİREBİR AYNIDIR. Oradan
# kopyalayabilirsin.
#
# Publishable key (Supabase'in eski adıyla "anon key") gizli DEĞİLDİR:
# Supabase onu istemciler için yayınlar, zaten telefon uygulamasının içinde
# dağıtılıyor. Tek başına hiçbir şeye erişim vermez; analitik okumaları
# veritabanındaki admin kontrolüne takılır.
#
# SUPABASE_SERVICE_ROLE_KEY buraya ya da bu klasöre asla konulmaz.
# O anahtar RLS'i ve admin kontrolünü tamamen atlar.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
